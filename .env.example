# Replace placeholders with local settings. The native helper's development
# PostgreSQL user and password are both "agency" unless you change the helper.
DATABASE_URL=postgresql+psycopg://YOUR_LOCAL_DB_USER:YOUR_LOCAL_DB_PASSWORD@127.0.0.1:55433/agency
APP_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="Agency Approval <no-reply@example.test>"

# Native services (Compose uses port 5432 instead)
PG_BIN=/usr/lib/postgresql/18/bin
PG_PORT=55433
MAILPIT_HTTP_PORT=8025
# Set on mounted filesystems without Unix permissions:
# PG_DATA_DIR=/home/YOUR_USER/.local/share/agency-change-approval/postgres
